<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Système de Gestion des Interventions</title>
    <!-- Chart.js Library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- html2pdf Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root {
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --primary-color: #0d6efd;
            --success-color: #198754;
            --warning-color: #fd7e14;
            --danger-color: #dc3545;
            --text-color: #212529;
            --border-color: #dee2e6;
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 12px;
        }

        h2, h3, h4 {
            text-align: center;
            margin-top: 5px;
            margin-bottom: 12px;
        }

        .container {
            max-width: 680px;
            margin: 0 auto;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .current-turn {
            background-color: #e7f1ff;
            border: 2px solid var(--primary-color);
            text-align: center;
        }

        .worker-name {
            font-size: 1.6rem;
            font-weight: bold;
            color: var(--danger-color);
            margin: 8px 0;
        }

        .input-group {
            display: flex;
            gap: 8px;
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .input-field {
            flex: 1;
            min-width: 130px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .input-field label {
            font-size: 0.8rem;
            font-weight: bold;
            color: #495057;
        }

        input, select {
            padding: 8px 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 0.9rem;
            width: 100%;
            box-sizing: border-box;
        }

        button {
            border: none;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 0.9rem;
            cursor: pointer;
            font-weight: bold;
            color: white;
            background-color: var(--primary-color);
        }

        .btn-success { background-color: var(--success-color); }
        .btn-warning { background-color: var(--warning-color); }
        .btn-danger { background-color: var(--danger-color); }
        .btn-secondary { background-color: #6c757d; }
        .btn-sm { padding: 4px 8px; font-size: 0.8rem; }

        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid var(--border-color);
            flex-wrap: wrap;
            gap: 5px;
        }

        .badge {
            background-color: #e9ecef;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: bold;
        }

        .rank-badge {
            background-color: #ffc107;
            color: #000;
            font-weight: bold;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            margin-right: 6px;
        }

        .status-tag {
            font-size: 0.85rem;
            font-weight: bold;
            padding: 4px 8px;
            border-radius: 4px;
            margin-top: 5px;
            display: inline-block;
        }

        .tag-critical { background-color: #ffe6e6; color: var(--danger-color); }
        .tag-normal { background-color: #e6ffed; color: var(--success-color); }

        .move-btns {
            display: flex;
            gap: 2px;
        }

        .canvas-container {
            position: relative;
            width: 100%;
            height: 480px;
            margin-top: 10px;
        }

        @media print {
            .no-print, button, input, select, .move-btns {
                display: none !important;
            }
            body {
                background-color: #fff;
            }
            .card {
                box-shadow: none;
                border: 1px solid #ccc;
            }
        }
    </style>
</head>
<body>

<div class="container" id="reportArea">
    <h2>Système de Gestion des Interventions</h2>

    <!-- Bouton Télécharger PDF -->
    <div style="margin-bottom: 15px; text-align: right;" class="no-print">
        <button class="btn-secondary" id="pdfBtn" onclick="exportToPDF()">📄 Télécharger le rapport (PDF)</button>
    </div>

    <!-- Ajouter un nouveau travailleur -->
    <div class="card no-print">
        <h4>Ajouter un agent à la file</h4>
        <div class="input-group">
            <input type="text" id="workerInput" placeholder="Nom de l'agent">
            <button onclick="addWorker()">Ajouter</button>
        </div>
    </div>

    <!-- Agent de garde / responsable -->
    <div class="card current-turn no-print">
        <h4>Responsable actuel de l'intervention</h4>
        <div class="worker-name" id="currentWorker">Aucun agent</div>
        <div id="timeStatus" class="status-tag"></div>

        <div style="margin-top: 15px; border-top: 1px dashed var(--border-color); padding-top: 12px;">
            <div class="input-group">
                <div class="input-field">
                    <label>Heure de départ:</label>
                    <input type="time" id="startTime">
                </div>
                <div class="input-field">
                    <label>Heure de retour:</label>
                    <input type="time" id="endTime">
                </div>
            </div>
            <button class="btn-success" style="width: 100%; margin-top: 8px;" onclick="recordIntervention()">Enregistrer l'intervention</button>
        </div>
    </div>

    <!-- Ordre de la file d'attente -->
    <div class="card no-print">
        <h4>File d'attente actuelle (Ajustement manuel)</h4>
        <ul id="queueList"></ul>
    </div>

    <!-- Graphique comparatif -->
    <div class="card">
        <h4>Comparatif des heures de travail (Graphique)</h4>
        <div class="canvas-container">
            <canvas id="comparisonChart"></canvas>
        </div>
    </div>

    <!-- Bilan cumulatif -->
    <div class="card">
        <h4>Bilan cumulatif (Trier par points)</h4>
        <ul id="statsList"></ul>
    </div>

    <!-- Historique -->
    <div class="card">
        <h4>Historique des interventions</h4>
        <select id="historyFilter" class="no-print" style="margin-bottom: 10px;" onchange="renderHistory()">
            <option value="ALL">Afficher tout l'historique</option>
        </select>
        <ul id="historyList"></ul>
        <br>
        <button class="btn-danger no-print" style="width:100%" onclick="resetAllData()">Réinitialiser le système</button>
    </div>
</div>

<script>
    let queue = JSON.parse(localStorage.getItem('shift_queue_v8')) || ['Mohamed', 'Sofiane', 'Hakim', 'Marwane', 'Adel'];
    let points = JSON.parse(localStorage.getItem('shift_points_v8')) || {
        'Mohamed': { normalMin: 0, criticalMin: 0, points: 0 },
        'Sofiane': { normalMin: 0, criticalMin: 0, points: 0 },
        'Hakim': { normalMin: 0, criticalMin: 0, points: 0 },
        'Marwane': { normalMin: 0, criticalMin: 0, points: 0 },
        'Adel': { normalMin: 0, criticalMin: 0, points: 0 }
    };
    let history = JSON.parse(localStorage.getItem('shift_history_v8')) || [];
    let comparisonChartInstance = null;

    function saveData() {
        localStorage.setItem('shift_queue_v8', JSON.stringify(queue));
        localStorage.setItem('shift_points_v8', JSON.stringify(points));
        localStorage.setItem('shift_history_v8', JSON.stringify(history));
        render();
    }

    function formatTime(totalMinutes) {
        const hrs = Math.floor(totalMinutes / 60);
        const mins = totalMinutes % 60;
        if (hrs > 0) {
            return `${hrs}h ${mins}m`;
        }
        return `${mins}m`;
    }

    function setCurrentTimeDefaults() {
        const now = new Date();
        const nowStr = now.toTimeString().substring(0, 5);
        document.getElementById('startTime').value = nowStr;
        
        const future = new Date(now.getTime() + 30 * 60000);
        document.getElementById('endTime').value = future.toTimeString().substring(0, 5);
    }

    function isCriticalHour(hour) {
        return (hour >= 16 && hour < 19) || (hour >= 0 && hour < 7);
    }

    function addWorker() {
        const input = document.getElementById('workerInput');
        const name = input.value.trim();
        if (name && !queue.includes(name)) {
            queue.push(name);
            if (!(name in points)) {
                points[name] = { normalMin: 0, criticalMin: 0, points: 0 };
            }
            input.value = '';
            saveData();
        }
    }

    function moveQueue(index, direction) {
        const targetIndex = index + direction;
        if (targetIndex >= 0 && targetIndex < queue.length) {
            const temp = queue[index];
            queue[index] = queue[targetIndex];
            queue[targetIndex] = temp;
            saveData();
        }
    }

    function removeWorkerFromQueue(name) {
        queue = queue.filter(w => w !== name);
        saveData();
    }

    function removeWorkerCompletely(name) {
        if (confirm(`Voulez-vous vraiment supprimer l'agent (${name}) ?`)) {
            queue = queue.filter(w => w !== name);
            delete points[name];
            saveData();
        }
    }

    function editWorkerStats(name) {
        const cur = points[name];
        const newNormalH = prompt(`Heures normales pour (${name}):`, Math.floor(cur.normalMin / 60));
        const newNormalM = prompt(`Minutes normales pour (${name}):`, cur.normalMin % 60);
        const newCritH = prompt(`Heures critiques pour (${name}):`, Math.floor(cur.criticalMin / 60));
        const newCritM = prompt(`Minutes critiques pour (${name}):`, cur.criticalMin % 60);

        if (newNormalH !== null && newCritH !== null) {
            const nMin = (parseInt(newNormalH) || 0) * 60 + (parseInt(newNormalM) || 0);
            const cMin = (parseInt(newCritH) || 0) * 60 + (parseInt(newCritM) || 0);
            const pts = (nMin / 60) + ((cMin / 60) * 2);

            points[name] = {
                normalMin: nMin,
                criticalMin: cMin,
                points: parseFloat(pts.toFixed(2))
            };
            saveData();
        }
    }

    function recordIntervention() {
        if (queue.length === 0) return;

        const startVal = document.getElementById('startTime').value;
        const endVal = document.getElementById('endTime').value;

        if (!startVal || !endVal) {
            alert('Veuillez sélectionner les heures de départ et de retour.');
            return;
        }

        const now = new Date();
        const startDate = new Date(now.toDateString() + ' ' + startVal);
        let endDate = new Date(now.toDateString() + ' ' + endVal);

        if (endDate <= startDate) {
            endDate.setDate(endDate.getDate() + 1);
        }

        let totalMinutes = Math.round((endDate - startDate) / 60000);
        let normalMin = 0;
        let criticalMin = 0;

        let tempDate = new Date(startDate.getTime());
        while (tempDate < endDate) {
            if (isCriticalHour(tempDate.getHours())) {
                criticalMin++;
            } else {
                normalMin++;
            }
            tempDate.setMinutes(tempDate.getMinutes() + 1);
        }

        const earnedPoints = (normalMin / 60) + ((criticalMin / 60) * 2);
        const currentWorker = queue.shift();

        if (!points[currentWorker]) {
            points[currentWorker] = { normalMin: 0, criticalMin: 0, points: 0 };
        }

        points[currentWorker].normalMin += normalMin;
        points[currentWorker].criticalMin += criticalMin;
        points[currentWorker].points += parseFloat(earnedPoints.toFixed(2));

        const yyyy = startDate.getFullYear();
        const mm = String(startDate.getMonth() + 1).padStart(2, '0');
        const dd = String(startDate.getDate()).padStart(2, '0');
        const dateStr = `${yyyy}-${mm}-${dd} | ${startVal} - ${endVal}`;

        history.push({
            worker: currentWorker,
            durationMin: totalMinutes,
            normalMin: normalMin,
            criticalMin: criticalMin,
            points: earnedPoints.toFixed(2),
            date: dateStr
        });

        queue.push(currentWorker);
        saveData();
        setCurrentTimeDefaults();
    }

    function resetAllData() {
        if (confirm('Attention : Toutes les données seront supprimées définitivement ! Continuer ?')) {
            localStorage.clear();
            queue = ['Mohamed', 'Sofiane', 'Hakim', 'Marwane', 'Adel'];
            points = {
                'Mohamed': { normalMin: 0, criticalMin: 0, points: 0 },
                'Sofiane': { normalMin: 0, criticalMin: 0, points: 0 },
                'Hakim': { normalMin: 0, criticalMin: 0, points: 0 },
                'Marwane': { normalMin: 0, criticalMin: 0, points: 0 },
                'Adel': { normalMin: 0, criticalMin: 0, points: 0 }
            };
            history = [];
            saveData();
        }
    }

    function renderHistory() {
        const historyList = document.getElementById('historyList');
        const filter = document.getElementById('historyFilter').value;
        historyList.innerHTML = '';

        const filteredHistory = filter === 'ALL' ? history : history.filter(h => h.worker === filter);

        if (filteredHistory.length === 0) {
            historyList.innerHTML = '<li style="justify-content:center; color:#6c757d;">Aucun historique enregistré</li>';
            return;
        }

        filteredHistory.forEach(item => {
            const li = document.createElement('li');
            li.style.flexDirection = 'column';
            li.style.alignItems = 'flex-start';

            li.innerHTML = `
                <div style="width:100%; display:flex; justify-content:space-between;">
                    <strong>${item.worker}</strong>
                    <span class="badge">Durée: ${formatTime(item.durationMin)} (${item.points} pts)</span>
                </div>
                <div style="width:100%; display:flex; justify-content:space-between; margin-top:4px; font-size:0.85rem;">
                    <span style="color:#6c757d;">📅 ${item.date}</span>
                    <span>☀ ${formatTime(item.normalMin)} Normale | 🚨 ${formatTime(item.criticalMin)} Critique</span>
                </div>
            `;
            historyList.appendChild(li);
        });
    }

    function updateComparisonChart() {
        const ctx = document.getElementById('comparisonChart').getContext('2d');
        const labels = Object.keys(points);
        const normalHours = labels.map(w => (points[w].normalMin / 60).toFixed(2));
        const criticalHours = labels.map(w => (points[w].criticalMin / 60).toFixed(2));

        if (comparisonChartInstance) {
            comparisonChartInstance.destroy();
        }

        comparisonChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Heures Normales',
                        data: normalHours,
                        backgroundColor: '#198754'
                    },
                    {
                        label: 'Heures Critiques',
                        data: criticalHours,
                        backgroundColor: '#dc3545'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { stacked: true },
                    y: { 
                        stacked: true,
                        title: { display: true, text: 'Temps en heures (h)' }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const workerName = context.label;
                                const isNormal = context.datasetIndex === 0;
                                const totalMin = isNormal ? points[workerName].normalMin : points[workerName].criticalMin;
                                
                                const hrs = Math.floor(totalMin / 60);
                                const mins = totalMin % 60;
                                let timeStr = hrs > 0 ? `${hrs}h ${mins}m` : `${mins}m`;

                                return `${context.dataset.label}: ${timeStr}`;
                            }
                        }
                    }
                }
            }
        });
    }

    function exportToPDF() {
        const element = document.getElementById('reportArea');
        const btn = document.getElementById('pdfBtn');
        btn.innerText = "⏳ Génération du PDF...";

        const noPrintElems = document.querySelectorAll('.no-print');
        noPrintElems.forEach(el => el.style.display = 'none');

        const opt = {
            margin:       [10, 10, 10, 10],
            filename:     'Rapport_Interventions.pdf',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        html2pdf().set(opt).from(element).save().then(() => {
            noPrintElems.forEach(el => el.style.display = '');
            btn.innerText = "📄 Télécharger le rapport (PDF)";
        }).catch(err => {
            console.error(err);
            window.print();
            noPrintElems.forEach(el => el.style.display = '');
            btn.innerText = "📄 Télécharger le rapport (PDF)";
        });
    }

    function render() {
        const currentWorkerElem = document.getElementById('currentWorker');
        const timeStatusElem = document.getElementById('timeStatus');

        if (queue.length > 0) {
            currentWorkerElem.innerText = queue[0];
        } else {
            currentWorkerElem.innerText = 'Aucun agent dans la file';
        }

        const nowHour = new Date().getHours();
        if (isCriticalHour(nowHour)) {
            timeStatusElem.innerText = '⚠️ Statut actuel: Période Critique (Points x2)';
            timeStatusElem.className = 'status-tag tag-critical';
        } else {
            timeStatusElem.innerText = '✅ Statut actuel: Période Normale (x1)';
            timeStatusElem.className = 'status-tag tag-normal';
        }

        const queueList = document.getElementById('queueList');
        queueList.innerHTML = '';
        queue.forEach((worker, index) => {
            const li = document.createElement('li');
            li.innerHTML = `
                <span><strong>#${index + 1}</strong> - ${worker}</span>
                <div style="display:flex; gap:6px; align-items:center;">
                    <div class="move-btns">
                        <button class="btn-secondary btn-sm" onclick="moveQueue(${index}, -1)" ${index === 0 ? 'disabled style="opacity:0.4"' : ''}>▲</button>
                        <button class="btn-secondary btn-sm" onclick="moveQueue(${index}, 1)" ${index === queue.length - 1 ? 'disabled style="opacity:0.4"' : ''}>▼</button>
                    </div>
                    <button class="btn-danger btn-sm" onclick="removeWorkerFromQueue('${worker}')">Retirer</button>
                </div>
            `;
            queueList.appendChild(li);
        });

        const sortedWorkers = Object.keys(points).sort((a, b) => points[b].points - points[a].points);

        const statsList = document.getElementById('statsList');
        const historyFilter = document.getElementById('historyFilter');
        
        statsList.innerHTML = '';
        historyFilter.innerHTML = '<option value="ALL">Afficher tout l\'historique</option>';

        sortedWorkers.forEach((worker, index) => {
            const data = points[worker];
            const totalMinutes = data.normalMin + data.criticalMin;

            const li = document.createElement('li');
            li.innerHTML = `
                <div style="width:100%; display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <span class="rank-badge">${index + 1}</span>
                        <strong>${worker}</strong>
                    </div>
                    <div class="no-print">
                        <span class="badge" style="background:#e7f1ff; color:var(--primary-color)">${data.points} pts</span>
                        <button class="btn-warning btn-sm" onclick="editWorkerStats('${worker}')">Modifier</button>
                        <button class="btn-danger btn-sm" onclick="removeWorkerCompletely('${worker}')">Supprimer</button>
                    </div>
                </div>

                <div style="width:100%; font-size:0.85rem; display:flex; justify-content:space-between; margin-top:6px; flex-wrap:wrap; gap:4px;">
                    <span>⏱ <strong>Temps Total:</strong> ${formatTime(totalMinutes)}</span>
                    <span>☀ Normal: ${formatTime(data.normalMin)}</span>
                    <span>🚨 Critique: ${formatTime(data.criticalMin)}</span>
                </div>
            `;
            statsList.appendChild(li);

            const opt = document.createElement('option');
            opt.value = worker;
            opt.innerText = `Historique: ${worker}`;
            historyFilter.appendChild(opt);
        });

        updateComparisonChart();
        renderHistory();
    }

    setCurrentTimeDefaults();
    render();
</script>

</body>
</html>
